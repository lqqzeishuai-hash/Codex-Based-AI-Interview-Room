{
  "name": "codex-interview-studio",
  "version": "0.2.1",
  "description": "基于 Codex Agent 的桌面语音面试室",
  "main": "src/main.cjs",
  "private": true,
  "author": "AI Interview Studio",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.cjs",
    "test": "node --test test/*.test.cjs",
    "test:integration": "node scripts/integration.cjs",
    "dist": "electron-builder --win portable --x64",
    "check": "node scripts/check.cjs",
    "test:context": "node scripts/context-integration.cjs"
  },
  "dependencies": {
    "smol-toml": "^1.3.4"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.codex.interviewstudio",
    "productName": "AI面试室",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "src/assets/icon.ico"
    },
    "portable": {
      "artifactName": "AI-Interview-Studio-${version}-Windows.exe"
    },
    "asarUnpack": [
      "src/native/**/*"
    ]
  }
}
